+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+use App\Core\Transaction;
+use DomainException;
+
+/** Estoque por local, sabor e tamanho, com histórico de todas as movimentações. */
+final class InventoryService
+{
+    public const MOVE_LABELS = ['entrada' => 'Entrada', 'venda' => 'Venda', 'estorno' => 'Estorno', 'transferencia' => 'Transferência', 'ajuste' => 'Ajuste'];
+
+    /** Linhas com saldo diferente de zero. */
+    public function matrix(?int $locationId = null): array
+    {
+        $sql = 'SELECT st.location_id, l.name AS location_name, l.color, st.flavor_id, f.name AS flavor_name,
+                       st.size_id, z.name AS size_name, z.volume_ml, st.qty, st.unit_value, st.qty * st.unit_value AS total_value
+                FROM ctl_stock st
+                JOIN ctl_locations l ON l.id = st.location_id
+                JOIN ctl_flavors f ON f.id = st.flavor_id
+                JOIN ctl_sizes z ON z.id = st.size_id
+                WHERE st.qty <> 0' . ($locationId ? ' AND st.location_id = ?' : '') . '
+                ORDER BY l.is_default DESC, l.name, f.name, z.volume_ml';
+        $stmt = Database::pdo()->prepare($sql);
+        $stmt->execute($locationId ? [$locationId] : []);
+        return $stmt->fetchAll();
+    }
+
+    public function locationTotals(): array
+    {
+        return Database::pdo()->query(
+            'SELECT l.id, l.name, l.color, l.is_default, l.is_active,
+                    COALESCE(SUM(st.qty), 0) AS qty, COALESCE(SUM(st.qty * st.unit_value), 0) AS total_value
+             FROM ctl_locations l LEFT JOIN ctl_stock st ON st.location_id = l.id
+             GROUP BY l.id, l.name, l.color, l.is_default, l.is_active
+             ORDER BY l.is_default DESC, l.name'
+        )->fetchAll();
+    }
+
+    /** Saldo por sabor (linhas) e tamanho (colunas), somando todos os locais ou só um. @return array{0:array,1:array} */
+    public function flavorGrid(?int $locationId = null): array
+    {
+        $sql = 'SELECT f.id AS flavor_id, f.name AS flavor_name, st.size_id, SUM(st.qty) AS qty
+                FROM ctl_stock st JOIN ctl_flavors f ON f.id = st.flavor_id'
+             . ($locationId ? ' WHERE st.location_id = ?' : '') . ' GROUP BY f.id, f.name, st.size_id HAVING SUM(st.qty) <> 0 ORDER BY f.name';
+        $stmt = Database::pdo()->prepare($sql);
+        $stmt->execute($locationId ? [$locationId] : []);
+        $rows = [];
+        foreach ($stmt->fetchAll() as $row) {
+            $rows[$row['flavor_id']]['name'] = $row['flavor_name'];
+            $rows[$row['flavor_id']]['sizes'][$row['size_id']] = (int) $row['qty'];
+        }
+        return $rows;
+    }
+
+    public function history(array $filter = [], int $limit = 150): array
+    {
+        $where = [];
+        $params = [];
+        if (!empty($filter['type']) && isset(self::MOVE_LABELS[$filter['type']])) {
+            $where[] = 'm.move_type = ?';
+            $params[] = $filter['type'];
+        }
+        if (!empty($filter['location_id'])) {
+            $where[] = '(m.from_location_id = ? OR m.to_location_id = ?)';
+            array_push($params, (int) $filter['location_id'], (int) $filter['location_id']);
+        }
+        $sql = 'SELECT m.id, m.moved_at, m.move_type, m.qty, m.note, m.order_no, f.name AS flavor_name, z.name AS size_name,
+                       lf.name AS from_name, lt.name AS to_name, u.name AS user_name
+                FROM ctl_stock_movements m
+                JOIN ctl_flavors f ON f.id = m.flavor_id
+                JOIN ctl_sizes z ON z.id = m.size_id
+                LEFT JOIN ctl_locations lf ON lf.id = m.from_location_id
+                LEFT JOIN ctl_locations lt ON lt.id = m.to_location_id
+                LEFT JOIN users u ON u.id = m.user_id'
+             . ($where ? ' WHERE ' . implode(' AND ', $where) : '') . ' ORDER BY m.id DESC LIMIT ' . max(1, min($limit, 500));
+        $stmt = Database::pdo()->prepare($sql);
+        $stmt->execute($params);
+        return $stmt->fetchAll();
+    }
+
+    // ------------------------------------------------------------------ ações do gestor
+
+    public function entry(int $locationId, int $flavorId, int $sizeId, int $qty, ?float $unitValue, string $note, ?int $userId, ?int $batchId = null): void
+    {
+        if ($qty < 1 || $qty > 999999) throw new DomainException('Informe uma quantidade de entrada entre 1 e 999999.');
+        Transaction::run(function () use ($locationId, $flavorId, $sizeId, $qty, $unitValue, $note, $userId, $batchId): void {
+            $this->bump($locationId, $flavorId, $sizeId, $qty);
+            if ($unitValue !== null && $unitValue > 0) $this->setUnitValue($locationId, $flavorId, $sizeId, $unitValue);
+            $this->log('entrada', null, $locationId, $flavorId, $sizeId, $qty, $note, null, null, $batchId, $userId);
+        });
+    }
+
+    /** Define o saldo final contado (o histórico guarda o saldo anterior). */
+    public function adjust(int $locationId, int $flavorId, int $sizeId, int $newQty, string $note, ?int $userId): void
+    {
+        if ($newQty < 0 || $newQty > 999999) throw new DomainException('Informe um saldo entre 0 e 999999.');
+        Transaction::run(function () use ($locationId, $flavorId, $sizeId, $newQty, $note, $userId): void {
+            $pdo = Database::pdo();
+            $this->bump($locationId, $flavorId, $sizeId, 0);
+            $stmt = $pdo->prepare('SELECT qty FROM ctl_stock WHERE location_id = ? AND flavor_id = ? AND size_id = ? FOR UPDATE');
+            $stmt->execute([$locationId, $flavorId, $sizeId]);
+            $old = (int) $stmt->fetchColumn();
+            $pdo->prepare('UPDATE ctl_stock SET qty = ? WHERE location_id = ? AND flavor_id = ? AND size_id = ?')
+                ->execute([$newQty, $locationId, $flavorId, $sizeId]);
+            $this->log('ajuste', null, $locationId, $flavorId, $sizeId, $newQty, trim($note) === '' ? "Ajuste manual (era $old)" : trim($note) . " (era $old)", null, null, null, $userId);
+        });
+    }
+
+    public function transfer(int $fromId, int $toId, int $flavorId, int $sizeId, int $qty, string $note, ?int $userId): void
+    {
+        if ($fromId === $toId) throw new DomainException('Escolha locais de origem e destino diferentes.');
+        if ($qty < 1 || $qty > 999999) throw new DomainException('Informe uma quantidade entre 1 e 999999.');
+        Transaction::run(function () use ($fromId, $toId, $flavorId, $sizeId, $qty, $note, $userId): void {
+            $pdo = Database::pdo();
+            $this->bump($fromId, $flavorId, $sizeId, 0);
+            $this->bump($toId, $flavorId, $sizeId, 0);
+            $stmt = $pdo->prepare(
+                'SELECT location_id, qty, unit_value FROM ctl_stock WHERE flavor_id = ? AND size_id = ? AND location_id IN (?, ?) ORDER BY location_id FOR UPDATE'
+            );
+            $stmt->execute([$flavorId, $sizeId, $fromId, $toId]);
+            $rows = [];
+            foreach ($stmt->fetchAll() as $row) $rows[(int) $row['location_id']] = $row;
+            if ((int) $rows[$fromId]['qty'] < $qty) {
+                $name = $pdo->prepare('SELECT name FROM ctl_locations WHERE id = ?');
+                $name->execute([$fromId]);
+                throw new DomainException('Estoque insuficiente em "' . $name->fetchColumn() . '". Disponível: ' . (int) $rows[$fromId]['qty'] . '.');
+            }
+            $this->bump($fromId, $flavorId, $sizeId, -$qty);
+            $this->bump($toId, $flavorId, $sizeId, $qty);
+            if ((float) $rows[$toId]['unit_value'] <= 0 && (float) $rows[$fromId]['unit_value'] > 0) {
+                $this->setUnitValue($toId, $flavorId, $sizeId, (float) $rows[$fromId]['unit_value']);
+            }
+            $this->log('transferencia', $fromId, $toId, $flavorId, $sizeId, $qty, trim($note), null, null, null, $userId);
+        });
+    }
+
+    // ------------------------------------------------------------------ usados por vendas e produção
+
+    public function consume(int $locationId, int $flavorId, int $sizeId, int $qty, string $note, int $saleId, int $orderNo, ?int $userId): void
+    {
+        $this->bump($locationId, $flavorId, $sizeId, -$qty);
+        $this->log('venda', $locationId, null, $flavorId, $sizeId, $qty, $note, $saleId, $orderNo, null, $userId);
+    }
+
+    public function restore(int $locationId, int $flavorId, int $sizeId, int $qty, string $note, int $saleId, int $orderNo, ?int $userId): void
+    {
+        $this->bump($locationId, $flavorId, $sizeId, $qty);
+        $this->log('estorno', null, $locationId, $flavorId, $sizeId, $qty, $note, $saleId, $orderNo, null, $userId);
+    }
+
+    /** Remove do estoque o que um lote de produção havia adicionado. */
+    public function revertBatch(int $locationId, int $flavorId, int $sizeId, int $qty, string $note, int $batchId, ?int $userId): void
+    {
+        $this->bump($locationId, $flavorId, $sizeId, -$qty);
+        $this->log('estorno', $locationId, null, $flavorId, $sizeId, $qty, $note, null, null, $batchId, $userId);
+    }
+
+    // ------------------------------------------------------------------ internos
+
+    private function bump(int $locationId, int $flavorId, int $sizeId, int $delta): void
+    {
+        Database::pdo()->prepare(
+            'INSERT INTO ctl_stock (location_id, flavor_id, size_id, qty, unit_value) VALUES (?, ?, ?, ?, 0)
+             ON DUPLICATE KEY UPDATE qty = qty + ?'
+        )->execute([$locationId, $flavorId, $sizeId, $delta, $delta]);
+    }
+
+    private function setUnitValue(int $locationId, int $flavorId, int $sizeId, float $value): void
+    {
+        Database::pdo()->prepare('UPDATE ctl_stock SET unit_value = ? WHERE location_id = ? AND flavor_id = ? AND size_id = ?')
+            ->execute([$value, $locationId, $flavorId, $sizeId]);
+    }
+
+    private function log(string $type, ?int $from, ?int $to, int $flavorId, int $sizeId, int $qty, string $note, ?int $saleId, ?int $orderNo, ?int $batchId, ?int $userId): void
+    {
+        Database::pdo()->prepare(
+            'INSERT INTO ctl_stock_movements (move_type, from_location_id, to_location_id, flavor_id, size_id, qty, note, sale_id, order_no, batch_id, user_id)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
+        )->execute([$type, $from, $to, $flavorId, $sizeId, $qty, mb_substr($note, 0, 200), $saleId, $orderNo, $batchId, $userId]);
+    }
+}
diff --git a/app/Services/PlanilhaService.php b/app/Services/PlanilhaService.php
new file mode 100644
index 0000000..82c7f44
--- /dev/null
+++ b/app/Services/PlanilhaService.php
@@ -0,0 +1,204 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Csv;
+use App\Core\Database;
+use App\Core\Money;
+use App\Core\Transaction;
+use DomainException;
+
+/** Exportação e importação em CSV/JSON, no formato do sistema atual do cliente (pedido;data;cliente;telefone;tam;qtd;sabor;valor;status). */
+final class PlanilhaService
+{
+    public const MAX_ROWS = 5000;
+
+    public function salesRows(array $filter): array
+    {
+        $rows = [['pedido', 'data', 'cliente', 'telefone', 'local', 'tam', 'qtd', 'sabor', 'valor', 'status']];
+        foreach ((new VendaService())->listLines($filter, self::MAX_ROWS) as $line) {
+            $rows[] = [$line['order_no'], $line['sale_date'], $line['client_name'], $line['client_phone'], $line['location_name'],
+                       $line['size_name'], $line['qty'], $line['flavor_name'], number_format((float) $line['unit_price'], 2, ',', ''), VendaService::label($line['status'])];
+        }
+        return $rows;
+    }
+
+    public function clientRows(): array
+    {
+        $rows = [['id', 'nome', 'telefone']];
+        foreach ((new ClienteService())->list() as $client) $rows[] = [$client['id'], $client['name'], $client['phone']];
+        return $rows;
+    }
+
+    /**
+     * Importa lançamentos. Reimportar o mesmo arquivo duplica os registros.
+     * @return array{imported:int,skipped:int,notes:string[]}
+     */
+    public function importSales(string $content, string $extension, int $locationId, bool $adjustStock, int $userId): array
+    {
+        $records = $this->records($content, $extension, 'items');
+        if (count($records) > self::MAX_ROWS) throw new DomainException('O arquivo tem mais de ' . self::MAX_ROWS . ' linhas. Divida em partes menores.');
+
+        $pdo = Database::pdo();
+        $catalog = new CatalogoService();
+        $clients = new ClienteService();
+        $sales = new VendaService();
+        $settings = new SettingsService();
+
+        $location = $pdo->prepare('SELECT 1 FROM ctl_locations WHERE id = ?');
+        $location->execute([$locationId]);
+        if (!$location->fetchColumn()) throw new DomainException('Escolha o local que receberá os lançamentos importados.');
+
+        return Transaction::run(function () use ($records, $locationId, $adjustStock, $userId, $pdo, $catalog, $clients, $sales, $settings): array {
+            $locations = [];
+            foreach ($catalog->locations() as $row) $locations[$this->key($row['name'])] = (int) $row['id'];
+            $flavors = [];
+            foreach ($catalog->flavors() as $row) $flavors[$this->key($row['name'])] = (int) $row['id'];
+            $sizes = [];
+            foreach ($catalog->sizes() as $row) $sizes[$this->key($row['name'])] = (int) $row['id'];
+
+            $insert = $pdo->prepare(
+                'INSERT INTO ctl_sales (order_no, sale_date, client_id, location_id, flavor_id, size_id, qty, unit_price, status, created_by)
+                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
+            );
+            $imported = 0;
+            $skipped = 0;
+            $notes = [];
+            $highest = 0;
+            $autoNumber = null;
+            $number = 0;
+
+            foreach ($records as $record) {
+                $number++;
+                $clientName = trim((string) ($record['cliente'] ?? ''));
+                $flavorName = trim((string) ($record['sabor'] ?? ''));
+                $sizeName = trim((string) ($record['tam'] ?? ''));
+                $qty = filter_var($record['qtd'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 9999]]);
+                $status = $this->statusFrom((string) ($record['status'] ?? ''));
+                if ($clientName === '' || $flavorName === '' || $sizeName === '' || $qty === false || $status === null) {
+                    $skipped++;
+                    if (count($notes) < 8) $notes[] = "Linha $number ignorada (cliente, sabor, tamanho, quantidade ou status inválidos).";
+                    continue;
+                }
+
+                $flavorKey = $this->key($flavorName);
+                if (!isset($flavors[$flavorKey])) {
+                    $pdo->prepare('INSERT INTO ctl_flavors (name) VALUES (?)')->execute([mb_substr($flavorName, 0, 120)]);
+                    $flavors[$flavorKey] = (int) $pdo->lastInsertId();
+                }
+                $sizeKey = $this->key($sizeName);
+                if (!isset($sizes[$sizeKey])) {
+                    $pdo->prepare('INSERT INTO ctl_sizes (name, volume_ml) VALUES (?, 1)')->execute([mb_substr($sizeName, 0, 60)]);
+                    $sizes[$sizeKey] = (int) $pdo->lastInsertId();
+                    if (count($notes) < 8) $notes[] = "Tamanho novo \"$sizeName\" criado com volume 1 mL. Ajuste o volume em Produtos para o custo ficar correto.";
+                }
+
+                $rowLocation = $locations[$this->key((string) ($record['local'] ?? ''))] ?? $locationId;
+                $orderNo = (int) preg_replace('/\D+/', '', (string) ($record['pedido'] ?? ''));
+                if ($orderNo < 1) {
+                    $autoNumber ??= $settings->nextNumber('next_order_no', 'SELECT COALESCE(MAX(order_no), 0) FROM ctl_sales');
+                    $orderNo = $autoNumber;
+                }
+                $price = $status === 'resgate' ? 0.0 : (Money::parse($record['valor'] ?? '') ?? 0.0);
+                $date = $this->dateFrom((string) ($record['data'] ?? ''));
+                $clientId = $clients->findOrCreate($clientName, (string) ($record['telefone'] ?? ''));
+
+                $insert->execute([$orderNo, $date, $clientId, $rowLocation, $flavors[$flavorKey], $sizes[$sizeKey], $qty, $price, $status, $userId]);
+                $saleId = (int) $pdo->lastInsertId();
+                if ($adjustStock) {
+                    $sales->syncStock(null, ['id' => $saleId, 'order_no' => $orderNo, 'location_id' => $rowLocation, 'flavor_id' => $flavors[$flavorKey], 'size_id' => $sizes[$sizeKey], 'qty' => $qty, 'status' => $status], $userId);
+                }
+                $highest = max($highest, $orderNo);
+                $imported++;
+            }
+            if ($highest > 0) $settings->ensureAbove('next_order_no', $highest);
+            return ['imported' => $imported, 'skipped' => $skipped, 'notes' => $notes];
+        });
+    }
+
+    /** @return array{imported:int,skipped:int,notes:string[]} */
+    public function importClients(string $content, string $extension): array
+    {
+        $records = $this->records($content, $extension, 'clients');
+        if (count($records) > self::MAX_ROWS) throw new DomainException('O arquivo tem mais de ' . self::MAX_ROWS . ' linhas.');
+        $clients = new ClienteService();
+        $pdo = Database::pdo();
+        return Transaction::run(function () use ($records, $clients, $pdo): array {
+            $imported = 0;
+            $skipped = 0;
+            $find = $pdo->prepare('SELECT 1 FROM ctl_clients WHERE name = ?');
+            foreach ($records as $record) {
+                $name = trim((string) ($record['nome'] ?? $record['name'] ?? ''));
+                $phone = trim((string) ($record['telefone'] ?? $record['phone'] ?? ''));
+                if ($name === '' || mb_strlen($name) > 120) {
+                    $skipped++;
+                    continue;
+                }
+                $find->execute([$name]);
+                if ($find->fetchColumn()) {
+                    $skipped++;
+                    $clients->findOrCreate($name, $phone);
+                    continue;
+                }
+                $clients->findOrCreate($name, $phone);
+                $imported++;
+            }
+            return ['imported' => $imported, 'skipped' => $skipped, 'notes' => []];
+        });
+    }
+
+    // ------------------------------------------------------------------ internos
+
+    /** Transforma CSV ou JSON em lista de registros associativos com chaves em minúsculas. */
+    private function records(string $content, string $extension, string $jsonKey): array
+    {
+        $content = trim($content);
+        if ($content === '') throw new DomainException('O arquivo está vazio.');
+        if ($extension === 'json') {
+            $data = json_decode(preg_replace('/^\xEF\xBB\xBF/', '', $content) ?? $content, true);
+            if (!is_array($data)) throw new DomainException('O JSON não pôde ser lido.');
+            $list = array_is_list($data) ? $data : ($data[$jsonKey] ?? []);
+            if (!is_array($list)) throw new DomainException("O JSON não tem a lista \"$jsonKey\".");
+            return array_map(static fn($row) => array_change_key_case(is_array($row) ? $row : [], CASE_LOWER), $list);
+        }
+        $rows = Csv::parse($content);
+        if (count($rows) < 2) throw new DomainException('O CSV precisa ter o cabeçalho e ao menos uma linha.');
+        $header = array_shift($rows);
+        $records = [];
+        foreach ($rows as $row) {
+            $record = [];
+            foreach ($header as $index => $name) $record[$name] = $row[$index] ?? '';
+            $records[] = $record;
+        }
+        return $records;
+    }
+
+    private function key(string $text): string
+    {
+        return mb_strtolower(trim(preg_replace('/\s+/', ' ', $text) ?? ''));
+    }
+
+    private function statusFrom(string $text): ?string
+    {
+        $plain = strtr($this->key($text), ['à' => 'a', 'á' => 'a', 'ã' => 'a', 'â' => 'a', 'é' => 'e', 'ê' => 'e', 'í' => 'i', 'ó' => 'o', 'õ' => 'o', 'ô' => 'o', 'ú' => 'u', 'ç' => 'c']);
+        if ($plain === '') return 'a_fazer';
+        return match ($plain) {
+            'a fazer', 'afazer' => 'a_fazer',
+            'a entregar', 'aentregar' => 'a_entregar',
+            'entregue' => 'entregue',
+            'pago' => 'pago',
+            'cancelado' => 'cancelado',
+            'resgate', 'resgatado' => 'resgate',
+            default => null,
+        };
+    }
+
+    private function dateFrom(string $text): string
+    {
+        $text = trim($text);
+        if (preg_match('/^(\d{4})-(\d{2})-(\d{2})/', $text, $m) && checkdate((int) $m[2], (int) $m[3], (int) $m[1])) return "$m[1]-$m[2]-$m[3]";
+        if (preg_match('#^(\d{1,2})/(\d{1,2})/(\d{4})#', $text, $m) && checkdate((int) $m[2], (int) $m[1], (int) $m[3])) return sprintf('%04d-%02d-%02d', $m[3], $m[2], $m[1]);
+        return date('Y-m-d');
+    }
+}
diff --git a/app/Services/ProducaoService.php b/app/Services/ProducaoService.php
new file mode 100644
index 0000000..bd276f0
--- /dev/null
+++ b/app/Services/ProducaoService.php
@@ -0,0 +1,204 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+use App\Core\Money;
+use App\Core\Transaction;
+use DateTimeImmutable;
+use DomainException;
+
+/**
+ * Lotes de produção. Ao confirmar um lote, as unidades entram no estoque do local escolhido e o custo
+ * total do lote é rateado por volume: custo por mL = custo total ÷ soma(qtd × mL); custo da unidade = mL × custo por mL + embalagem.
+ */
+final class ProducaoService
+{
+    private InventoryService $stock;
+    private CatalogoService $catalog;
+    private SettingsService $settings;
+
+    public function __construct()
+    {
+        $this->stock = new InventoryService();
+        $this->catalog = new CatalogoService();
+        $this->settings = new SettingsService();
+    }
+
+    /** Custo unitário por tamanho. @param array<int,int> $qtyBySize size_id => quantidade @return array<int,float> */
+    public function unitCosts(float $totalCost, array $qtyBySize): array
+    {
+        if ($totalCost <= 0 || !$qtyBySize) return [];
+        $sizes = [];
+        foreach ($this->catalog->sizes() as $size) $sizes[(int) $size['id']] = $size;
+        $weighted = 0.0;
+        foreach ($qtyBySize as $sizeId => $qty) $weighted += $qty * (float) ($sizes[$sizeId]['volume_ml'] ?? 0);
+        if ($weighted <= 0) return [];
+        $perMl = $totalCost / $weighted;
+        $costs = [];
+        foreach ($qtyBySize as $sizeId => $qty) {
+            $size = $sizes[$sizeId] ?? null;
+            if ($size) $costs[$sizeId] = round($perMl * (float) $size['volume_ml'] + (float) $size['packaging_cost'], 4);
+        }
+        return $costs;
+    }
+
+    public function nextNumber(): int
+    {
+        $pdo = Database::pdo();
+        $stored = (int) $this->settings->get('next_batch_no', '1');
+        $used = (int) $pdo->query('SELECT COALESCE(MAX(batch_no), 0) FROM ctl_batches')->fetchColumn();
+        return max(1, $stored, $used + 1);
+    }
+
+    public function list(): array
+    {
+        $batches = Database::pdo()->query(
+            'SELECT b.id, b.batch_no, b.batch_date, b.total_cost, b.note, l.name AS location_name, l.color AS location_color,
+                    COALESCE((SELECT SUM(i.qty) FROM ctl_batch_items i WHERE i.batch_id = b.id), 0) AS units
+             FROM ctl_batches b JOIN ctl_locations l ON l.id = b.location_id ORDER BY b.batch_date DESC, b.id DESC LIMIT 60'
+        )->fetchAll();
+        if (!$batches) return [];
+        $ids = array_column($batches, 'id');
+        $in = implode(',', array_fill(0, count($ids), '?'));
+        $stmt = Database::pdo()->prepare(
+            "SELECT i.batch_id, i.qty, i.unit_price, i.unit_cost, f.name AS flavor_name, z.name AS size_name
+             FROM ctl_batch_items i JOIN ctl_flavors f ON f.id = i.flavor_id JOIN ctl_sizes z ON z.id = i.size_id
+             WHERE i.batch_id IN ($in) ORDER BY f.name, z.volume_ml"
+        );
+        $stmt->execute($ids);
+        $items = [];
+        foreach ($stmt->fetchAll() as $item) $items[$item['batch_id']][] = $item;
+        foreach ($batches as &$batch) $batch['items'] = $items[$batch['id']] ?? [];
+        unset($batch);
+        return $batches;
+    }
+
+    /**
+     * @param array $in batch_no (opcional), batch_date, location_id, total_cost, note, lines[] = [flavor_id, size_id, qty, unit_price]
+     * @return int id do lote
+     */
+    public function create(array $in, int $userId): int
+    {
+        $date = $this->date((string) ($in['batch_date'] ?? ''));
+        $locationId = (int) ($in['location_id'] ?? 0);
+        $cost = $this->cost($in['total_cost'] ?? '');
+        $note = $this->note($in['note'] ?? '');
+        $rawLines = array_values((array) ($in['lines'] ?? []));
+        if (!$rawLines) throw new DomainException('Adicione ao menos um item ao lote.');
+        if (count($rawLines) > 80) throw new DomainException('Um lote pode ter no máximo 80 itens.');
+
+        $location = Database::pdo()->prepare('SELECT 1 FROM ctl_locations WHERE id = ?');
+        $location->execute([$locationId]);
+        if (!$location->fetchColumn()) throw new DomainException('Escolha o local que recebe a produção.');
+
+        $prices = $this->catalog->priceMap($locationId);
+        $lines = [];
+        foreach ($rawLines as $raw) {
+            $flavorId = (int) ($raw['flavor_id'] ?? 0);
+            $sizeId = (int) ($raw['size_id'] ?? 0);
+            $qty = filter_var($raw['qty'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 99999]]);
+            if ($flavorId < 1 || $sizeId < 1 || $qty === false) throw new DomainException('Há um item do lote com sabor, tamanho ou quantidade inválidos.');
+            $price = Money::parse($raw['unit_price'] ?? '') ?? ($prices[$flavorId . '|' . $sizeId] ?? 0.0);
+            $lines[] = ['flavor_id' => $flavorId, 'size_id' => $sizeId, 'qty' => $qty, 'unit_price' => $price];
+        }
+
+        return (int) Transaction::run(function () use ($in, $date, $locationId, $cost, $note, $lines, $userId): int {
+            $pdo = Database::pdo();
+            $number = filter_var($in['batch_no'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 9999999]]) ?: $this->nextNumber();
+            $exists = $pdo->prepare('SELECT 1 FROM ctl_batches WHERE batch_no = ?');
+            $exists->execute([$number]);
+            if ($exists->fetchColumn()) throw new DomainException("O lote $number já existe. Use outro número.");
+
+            $pdo->prepare('INSERT INTO ctl_batches (batch_no, batch_date, location_id, total_cost, note, created_by) VALUES (?, ?, ?, ?, ?, ?)')
+                ->execute([$number, $date, $locationId, $cost, $note, $userId]);
+            $batchId = (int) $pdo->lastInsertId();
+
+            $qtyBySize = [];
+            foreach ($lines as $line) $qtyBySize[$line['size_id']] = ($qtyBySize[$line['size_id']] ?? 0) + $line['qty'];
+            $costs = $this->unitCosts($cost, $qtyBySize);
+
+            $insert = $pdo->prepare('INSERT INTO ctl_batch_items (batch_id, flavor_id, size_id, qty, unit_price, unit_cost) VALUES (?, ?, ?, ?, ?, ?)');
+            foreach ($lines as $line) {
+                $unitCost = $costs[$line['size_id']] ?? null;
+                $insert->execute([$batchId, $line['flavor_id'], $line['size_id'], $line['qty'], $line['unit_price'], $unitCost]);
+                // o valor da unidade em estoque é o custo; sem custo informado, usa o preço de venda
+                $this->stock->entry($locationId, $line['flavor_id'], $line['size_id'], $line['qty'], $unitCost ?? $line['unit_price'], "Lote $number", $userId, $batchId);
+            }
+            (new SettingsService())->ensureAbove('next_batch_no', $number);
+            return $batchId;
+        });
+    }
+
+    /** Corrige dados do lote (número, data, custo e observação) e recalcula o custo unitário dos itens. */
+    public function update(int $id, array $in): void
+    {
+        $date = $this->date((string) ($in['batch_date'] ?? ''));
+        $cost = $this->cost($in['total_cost'] ?? '');
+        $note = $this->note($in['note'] ?? '');
+        $number = filter_var($in['batch_no'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 9999999]]);
+        if ($number === false) throw new DomainException('Informe um número de lote válido.');
+
+        Transaction::run(function () use ($id, $date, $cost, $note, $number): void {
+            $pdo = Database::pdo();
+            $batch = $pdo->prepare('SELECT id FROM ctl_batches WHERE id = ? FOR UPDATE');
+            $batch->execute([$id]);
+            if (!$batch->fetchColumn()) throw new DomainException('Lote não encontrado.');
+            $dup = $pdo->prepare('SELECT 1 FROM ctl_batches WHERE batch_no = ? AND id <> ?');
+            $dup->execute([$number, $id]);
+            if ($dup->fetchColumn()) throw new DomainException("O lote $number já existe. Use outro número.");
+
+            $pdo->prepare('UPDATE ctl_batches SET batch_no = ?, batch_date = ?, total_cost = ?, note = ? WHERE id = ?')->execute([$number, $date, $cost, $note, $id]);
+            $items = $pdo->prepare('SELECT id, size_id, qty FROM ctl_batch_items WHERE batch_id = ?');
+            $items->execute([$id]);
+            $rows = $items->fetchAll();
+            $qtyBySize = [];
+            foreach ($rows as $row) $qtyBySize[(int) $row['size_id']] = ($qtyBySize[(int) $row['size_id']] ?? 0) + (int) $row['qty'];
+            $costs = $this->unitCosts($cost, $qtyBySize);
+            $update = $pdo->prepare('UPDATE ctl_batch_items SET unit_cost = ? WHERE id = ?');
+            foreach ($rows as $row) $update->execute([$costs[(int) $row['size_id']] ?? null, $row['id']]);
+            (new SettingsService())->ensureAbove('next_batch_no', $number);
+        });
+    }
+
+    /** Exclui o lote e desfaz no estoque as unidades que ele havia adicionado. */
+    public function delete(int $id, ?int $userId): void
+    {
+        Transaction::run(function () use ($id, $userId): void {
+            $pdo = Database::pdo();
+            $batch = $pdo->prepare('SELECT batch_no, location_id FROM ctl_batches WHERE id = ? FOR UPDATE');
+            $batch->execute([$id]);
+            $head = $batch->fetch();
+            if (!$head) throw new DomainException('Lote não encontrado.');
+            $items = $pdo->prepare('SELECT flavor_id, size_id, qty FROM ctl_batch_items WHERE batch_id = ? ORDER BY flavor_id, size_id');
+            $items->execute([$id]);
+            foreach ($items->fetchAll() as $item) {
+                $this->stock->revertBatch((int) $head['location_id'], (int) $item['flavor_id'], (int) $item['size_id'], (int) $item['qty'], 'Exclusão do lote ' . $head['batch_no'], $id, $userId);
+            }
+            $pdo->prepare('DELETE FROM ctl_batches WHERE id = ?')->execute([$id]);
+        });
+    }
+
+    private function date(string $value): string
+    {
+        $date = DateTimeImmutable::createFromFormat('!Y-m-d', trim($value));
+        if (!$date || $date->format('Y-m-d') !== trim($value)) throw new DomainException('Informe uma data válida.');
+        return $date->format('Y-m-d');
+    }
+
+    private function cost(mixed $value): float
+    {
+        if (trim((string) $value) === '') return 0.0;
+        $cost = Money::parse($value);
+        if ($cost === null || $cost > 9999999) throw new DomainException('Informe um custo total válido, por exemplo 180,00.');
+        return $cost;
+    }
+
+    private function note(mixed $value): string
+    {
+        $note = trim((string) $value);
+        if (mb_strlen($note) > 200) throw new DomainException('A observação deve ter no máximo 200 caracteres.');
+        return $note;
+    }
+}
diff --git a/app/Services/RelatorioService.php b/app/Services/RelatorioService.php
new file mode 100644
index 0000000..6efaff2
--- /dev/null
+++ b/app/Services/RelatorioService.php
@@ -0,0 +1,103 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+
+/** Relatórios de vendas. Contam só vendas efetivas: cancelados e resgates ficam de fora. */
+final class RelatorioService
+{
+    private const VALID = "s.status NOT IN ('cancelado', 'resgate')";
+
+    public function overview(): array
+    {
+        $pdo = Database::pdo();
+        $rows = $pdo->query(
+            "SELECT DATE_FORMAT(s.sale_date, '%Y-%m') AS ym, SUM(s.qty) AS units, SUM(s.qty * s.unit_price) AS revenue, COUNT(DISTINCT s.order_no) AS orders
+             FROM ctl_sales s WHERE " . self::VALID . ' GROUP BY ym'
+        )->fetchAll();
+        $byMonth = [];
+        foreach ($rows as $row) $byMonth[$row['ym']] = ['units' => (int) $row['units'], 'revenue' => (float) $row['revenue'], 'orders' => (int) $row['orders']];
+
+        $series = [];
+        for ($i = 5; $i >= 0; $i--) {
+            $ym = date('Y-m', strtotime(date('Y-m-01') . " -$i month"));
+            $series[] = ['ym' => $ym] + ($byMonth[$ym] ?? ['units' => 0, 'revenue' => 0.0, 'orders' => 0]);
+        }
+        $revenue = array_sum(array_column($byMonth, 'revenue'));
+        $orders = (int) $pdo->query('SELECT COUNT(DISTINCT s.order_no) FROM ctl_sales s WHERE ' . self::VALID)->fetchColumn();
+        $current = $byMonth[date('Y-m')] ?? ['units' => 0, 'revenue' => 0.0, 'orders' => 0];
+        $previous = $byMonth[date('Y-m', strtotime(date('Y-m-01') . ' -1 month'))] ?? ['units' => 0, 'revenue' => 0.0, 'orders' => 0];
+        $variation = $previous['revenue'] > 0 ? ($current['revenue'] - $previous['revenue']) / $previous['revenue'] * 100 : null;
+
+        return [
+            'revenue' => (float) $revenue,
+            'units' => array_sum(array_column($byMonth, 'units')),
+            'orders' => $orders,
+            'ticket' => $orders > 0 ? $revenue / $orders : 0.0,
+            'current' => $current,
+            'previous' => $previous,
+            'variation' => $variation,
+            'series' => $series,
+            'status_counts' => $pdo->query('SELECT status, COUNT(*) AS n FROM ctl_sales GROUP BY status')->fetchAll(\PDO::FETCH_KEY_PAIR),
+        ];
+    }
+
+    public function monthly(): array
+    {
+        $pdo = Database::pdo();
+        $months = $pdo->query(
+            "SELECT DATE_FORMAT(s.sale_date, '%Y-%m') AS ym, SUM(s.qty) AS units, SUM(s.qty * s.unit_price) AS revenue, COUNT(DISTINCT s.order_no) AS orders
+             FROM ctl_sales s WHERE " . self::VALID . ' GROUP BY ym ORDER BY ym DESC'
+        )->fetchAll();
+        $bySize = [];
+        foreach ($pdo->query(
+            "SELECT DATE_FORMAT(s.sale_date, '%Y-%m') AS ym, z.name AS size, SUM(s.qty) AS units
+             FROM ctl_sales s JOIN ctl_sizes z ON z.id = s.size_id WHERE " . self::VALID . ' GROUP BY ym, z.id, z.name'
+        )->fetchAll() as $row) $bySize[$row['ym']][$row['size']] = (int) $row['units'];
+        foreach ($months as &$month) {
+            $month['ticket'] = (int) $month['orders'] > 0 ? (float) $month['revenue'] / (int) $month['orders'] : 0.0;
+            $month['by_size'] = $bySize[$month['ym']] ?? [];
+        }
+        unset($month);
+        return $months;
+    }
+
+    /** Ranking por sabor e por tamanho, opcionalmente dentro de um mês (YYYY-MM). */
+    public function products(string $month = 'all'): array
+    {
+        [$period, $params] = $this->period($month);
+        $pdo = Database::pdo();
+        $byFlavor = $pdo->prepare(
+            'SELECT f.name, SUM(s.qty) AS units, SUM(s.qty * s.unit_price) AS revenue
+             FROM ctl_sales s JOIN ctl_flavors f ON f.id = s.flavor_id WHERE ' . self::VALID . $period . ' GROUP BY f.id, f.name ORDER BY revenue DESC, units DESC'
+        );
+        $byFlavor->execute($params);
+        $bySize = $pdo->prepare(
+            'SELECT z.name, SUM(s.qty) AS units, SUM(s.qty * s.unit_price) AS revenue
+             FROM ctl_sales s JOIN ctl_sizes z ON z.id = s.size_id WHERE ' . self::VALID . $period . ' GROUP BY z.id, z.name, z.volume_ml ORDER BY z.volume_ml'
+        );
+        $bySize->execute($params);
+        return ['flavors' => $byFlavor->fetchAll(), 'sizes' => $bySize->fetchAll()];
+    }
+
+    public function topClients(string $month = 'all', int $limit = 30): array
+    {
+        [$period, $params] = $this->period($month);
+        $stmt = Database::pdo()->prepare(
+            'SELECT c.name, SUM(s.qty) AS units, SUM(s.qty * s.unit_price) AS revenue, COUNT(DISTINCT s.order_no) AS orders
+             FROM ctl_sales s JOIN ctl_clients c ON c.id = s.client_id WHERE ' . self::VALID . $period
+             . ' GROUP BY c.id, c.name ORDER BY revenue DESC LIMIT ' . max(1, min($limit, 200))
+        );
+        $stmt->execute($params);
+        return $stmt->fetchAll();
+    }
+
+    private function period(string $month): array
+    {
+        if (!preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $month)) return ['', []];
+        $start = $month . '-01';
+        return [' AND s.sale_date >= ? AND s.sale_date < ?', [$start, date('Y-m-d', strtotime($start . ' +1 month'))]];
+    }
+}
diff --git a/app/Services/SettingsService.php b/app/Services/SettingsService.php
new file mode 100644
index 0000000..b776c41
--- /dev/null
+++ b/app/Services/SettingsService.php
@@ -0,0 +1,43 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+
+/** Pequenas configurações do controle (contadores e regras da fidelidade) guardadas em ctl_settings. */
+final class SettingsService
+{
+    public function get(string $key, string $default = ''): string
+    {
+        $stmt = Database::pdo()->prepare('SELECT setting_value FROM ctl_settings WHERE setting_key = ?');
+        $stmt->execute([$key]);
+        $value = $stmt->fetchColumn();
+        return $value === false ? $default : (string) $value;
+    }
+
+    public function set(string $key, string $value): void
+    {
+        Database::pdo()->prepare(
+            'INSERT INTO ctl_settings (setting_key, setting_value) VALUES (?, ?) ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)'
+        )->execute([$key, $value]);
+    }
+
+    /** Reserva e devolve o próximo número de uma sequência (pedido ou lote), nunca repetindo um número já usado. */
+    public function nextNumber(string $settingKey, string $usedSql): int
+    {
+        $pdo = Database::pdo();
+        $stmt = $pdo->prepare('SELECT setting_value FROM ctl_settings WHERE setting_key = ? FOR UPDATE');
+        $stmt->execute([$settingKey]);
+        $stored = $stmt->fetchColumn();
+        $next = max(1, (int) ($stored === false ? 1 : $stored), (int) $pdo->query($usedSql)->fetchColumn() + 1);
+        $this->set($settingKey, (string) ($next + 1));
+        return $next;
+    }
+
+    /** Garante que o contador fique acima de um número informado manualmente ou importado. */
+    public function ensureAbove(string $settingKey, int $used): void
+    {
+        if ((int) $this->get($settingKey, '1') <= $used) $this->set($settingKey, (string) ($used + 1));
+    }
+}
diff --git a/app/Services/VendaService.php b/app/Services/VendaService.php
new file mode 100644
index 0000000..54488b3
--- /dev/null
+++ b/app/Services/VendaService.php
@@ -0,0 +1,302 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+use App\Core\Money;
+use App\Core\Transaction;
+use DateTimeImmutable;
+use DomainException;
+
+/**
+ * Lançamentos de venda do gestor. Cada linha é um item; itens do mesmo pedido compartilham o order_no.
+ * Regra de estoque: toda linha que não esteja "Cancelado" (inclui "Resgate") reserva a quantidade no local da venda.
+ */
+final class VendaService
+{
+    public const STATUSES = [
+        'a_fazer' => 'A Fazer', 'a_entregar' => 'À Entregar', 'entregue' => 'Entregue',
+        'pago' => 'Pago', 'cancelado' => 'Cancelado', 'resgate' => 'Resgate',
+    ];
+    /** Valores ainda a receber */
+    public const OPEN = ['a_fazer', 'a_entregar', 'entregue'];
+    /** Ainda não entregues */
+    public const PENDING = ['a_fazer', 'a_entregar'];
+    public const SORTS = [
+        'pedido-desc' => 's.order_no DESC, s.id DESC', 'pedido-asc' => 's.order_no ASC, s.id ASC',
+        'recent' => 's.id DESC', 'oldest' => 's.id ASC', 'sabor-asc' => 'f.name ASC, s.order_no DESC',
+    ];
+
+    private InventoryService $stock;
+    private ClienteService $clients;
+    private CatalogoService $catalog;
+    private SettingsService $settings;
+
+    public function __construct()
+    {
+        $this->stock = new InventoryService();
+        $this->clients = new ClienteService();
+        $this->catalog = new CatalogoService();
+        $this->settings = new SettingsService();
+    }
+
+    public static function label(string $status): string
+    {
+        return self::STATUSES[$status] ?? $status;
+    }
+
+    // ------------------------------------------------------------------ consulta
+
+    public function listLines(array $filter, int $limit = 500): array
+    {
+        [$where, $params] = $this->conditions($filter);
+        $sort = self::SORTS[$filter['sort'] ?? ''] ?? self::SORTS['pedido-desc'];
+        $sql = 'SELECT s.id, s.order_no, s.sale_date, s.qty, s.unit_price, s.status,
+                       c.id AS client_id, c.name AS client_name, c.phone AS client_phone,
+                       l.name AS location_name, l.color AS location_color, f.name AS flavor_name, z.name AS size_name
+                FROM ctl_sales s
+                JOIN ctl_clients c ON c.id = s.client_id
+                JOIN ctl_locations l ON l.id = s.location_id
+                JOIN ctl_flavors f ON f.id = s.flavor_id
+                JOIN ctl_sizes z ON z.id = s.size_id'
+             . ($where ? ' WHERE ' . implode(' AND ', $where) : '') . " ORDER BY $sort LIMIT " . max(1, min($limit, 5000));
+        $stmt = Database::pdo()->prepare($sql);
+        $stmt->execute($params);
+        return $stmt->fetchAll();
+    }
+
+    public function find(int $id): ?array
+    {
+        $stmt = Database::pdo()->prepare(
+            'SELECT s.*, c.name AS client_name, c.phone AS client_phone FROM ctl_sales s JOIN ctl_clients c ON c.id = s.client_id WHERE s.id = ?'
+        );
+        $stmt->execute([$id]);
+        return $stmt->fetch() ?: null;
+    }
+
+    /** Números do cabeçalho da tela de vendas para o mês escolhido ('all' = tudo). */
+    public function kpis(string $month): array
+    {
+        $pdo = Database::pdo();
+        [$where, $params] = $this->conditions(['month' => $month]);
+        $stmt = $pdo->prepare(
+            "SELECT COUNT(DISTINCT s.order_no) AS orders,
+                    COALESCE(SUM(CASE WHEN s.status <> 'cancelado' THEN s.qty * s.unit_price END), 0) AS revenue
+             FROM ctl_sales s" . ($where ? ' WHERE ' . implode(' AND ', $where) : '')
+        );
+        $stmt->execute($params);
+        $totals = $stmt->fetch();
+
+        $on = $where ? ' AND ' . implode(' AND ', $where) : '';
+        $sizes = $pdo->prepare(
+            "SELECT z.name, COALESCE(SUM(s.qty), 0) AS qty FROM ctl_sizes z
+             LEFT JOIN ctl_sales s ON s.size_id = z.id AND s.status <> 'cancelado'$on
+             WHERE z.is_active = 1 GROUP BY z.id, z.name, z.volume_ml ORDER BY z.volume_ml"
+        );
+        $sizes->execute($params);
+
+        return [
+            'orders' => (int) $totals['orders'],
+            'revenue' => (float) $totals['revenue'],
+            'by_size' => $sizes->fetchAll(),
+            'pending' => (int) $pdo->query("SELECT COUNT(*) FROM ctl_sales WHERE status IN ('a_fazer', 'a_entregar')")->fetchColumn(),
+        ];
+    }
+
+    public function months(): array
+    {
+        return Database::pdo()->query("SELECT DISTINCT DATE_FORMAT(sale_date, '%Y-%m') AS ym FROM ctl_sales ORDER BY ym DESC")->fetchAll(\PDO::FETCH_COLUMN);
+    }
+
+    /** Resumo mensal por sabor e por sabor + tamanho (não considera cancelados). */
+    public function monthSummary(string $month): array
+    {
+        [$where, $params] = $this->conditions(['month' => $month]);
+        $where[] = "s.status <> 'cancelado'";
+        $base = 'FROM ctl_sales s JOIN ctl_flavors f ON f.id = s.flavor_id JOIN ctl_sizes z ON z.id = s.size_id WHERE ' . implode(' AND ', $where);
+        $pdo = Database::pdo();
+        $byFlavor = $pdo->prepare("SELECT f.name AS flavor, SUM(s.qty) AS qty, SUM(s.qty * s.unit_price) AS value $base GROUP BY f.id, f.name ORDER BY f.name");
+        $byFlavor->execute($params);
+        $bySize = $pdo->prepare("SELECT f.name AS flavor, z.name AS size, SUM(s.qty) AS qty, SUM(s.qty * s.unit_price) AS value $base GROUP BY f.id, f.name, z.id, z.name, z.volume_ml ORDER BY f.name, z.volume_ml");
+        $bySize->execute($params);
+        return ['by_flavor' => $byFlavor->fetchAll(), 'by_size' => $bySize->fetchAll()];
+    }
+
+    // ------------------------------------------------------------------ escrita
+
+    /**
+     * Lança um pedido com vários itens. $in: client_name, client_phone, location_id, sale_date,
+     * lines[] = [flavor_id, size_id, qty, unit_price (vazio = preço do catálogo), status].
+     * @return int número do pedido
+     */
+    public function createOrder(array $in, int $userId): int
+    {
+        $locationId = $this->validLocation((int) ($in['location_id'] ?? 0));
+        $date = $this->parseDate((string) ($in['sale_date'] ?? ''));
+        $rawLines = array_values((array) ($in['lines'] ?? []));
+        if (!$rawLines) throw new DomainException('Adicione ao menos um item ao pedido.');
+        if (count($rawLines) > 60) throw new DomainException('Um pedido pode ter no máximo 60 itens.');
+        $lines = array_map(fn($raw) => $this->normalizeLine((array) $raw, $locationId), $rawLines);
+
+        return (int) Transaction::run(function () use ($in, $locationId, $date, $lines, $userId): int {
+            $pdo = Database::pdo();
+            $clientId = $this->clients->findOrCreate((string) ($in['client_name'] ?? ''), (string) ($in['client_phone'] ?? ''));
+            $orderNo = $this->settings->nextNumber('next_order_no', 'SELECT COALESCE(MAX(order_no), 0) FROM ctl_sales');
+            $insert = $pdo->prepare(
+                'INSERT INTO ctl_sales (order_no, sale_date, client_id, location_id, flavor_id, size_id, qty, unit_price, status, created_by)
+                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
+            );
+            foreach ($lines as $line) {
+                $insert->execute([$orderNo, $date, $clientId, $locationId, $line['flavor_id'], $line['size_id'], $line['qty'], $line['unit_price'], $line['status'], $userId]);
+                $saleId = (int) $pdo->lastInsertId();
+                $this->syncStock(null, $line + ['id' => $saleId, 'order_no' => $orderNo, 'location_id' => $locationId], $userId);
+            }
+            return $orderNo;
+        });
+    }
+
+    /** Edita uma linha inteira (cliente, local, produto, quantidade, valor, status, número do pedido e data). */
+    public function updateLine(int $id, array $in, int $userId): void
+    {
+        $locationId = $this->validLocation((int) ($in['location_id'] ?? 0));
+        $date = $this->parseDate((string) ($in['sale_date'] ?? ''));
+        $orderNo = filter_var($in['order_no'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 9999999]]);
+        if ($orderNo === false) throw new DomainException('Informe um número de pedido válido.');
+        $line = $this->normalizeLine($in, $locationId);
+
+        Transaction::run(function () use ($id, $in, $locationId, $date, $orderNo, $line, $userId): void {
+            $old = $this->lock($id);
+            $clientId = $this->clients->findOrCreate((string) ($in['client_name'] ?? ''), (string) ($in['client_phone'] ?? ''));
+            Database::pdo()->prepare(
+                'UPDATE ctl_sales SET order_no = ?, sale_date = ?, client_id = ?, location_id = ?, flavor_id = ?, size_id = ?, qty = ?, unit_price = ?, status = ? WHERE id = ?'
+            )->execute([$orderNo, $date, $clientId, $locationId, $line['flavor_id'], $line['size_id'], $line['qty'], $line['unit_price'], $line['status'], $id]);
+            $this->syncStock($old, $line + ['id' => $id, 'order_no' => $orderNo, 'location_id' => $locationId], $userId);
+            $this->settings->ensureAbove('next_order_no', $orderNo);
+        });
+    }
+
+    public function changeStatus(int $id, string $status, int $userId): void
+    {
+        if (!isset(self::STATUSES[$status])) throw new DomainException('Situação inválida.');
+        Transaction::run(function () use ($id, $status, $userId): void {
+            $old = $this->lock($id);
+            $price = (float) $old['unit_price'];
+            if ($status === 'resgate') {
+                $price = 0.0;
+            } elseif ($old['status'] === 'resgate' && $price <= 0) {
+                // saindo de "Resgate": volta ao preço do catálogo para que a cobrança faça sentido
+                $price = $this->catalog->price((int) $old['flavor_id'], (int) $old['size_id'], (int) $old['location_id']) ?? 0.0;
+            }
+            Database::pdo()->prepare('UPDATE ctl_sales SET status = ?, unit_price = ? WHERE id = ?')->execute([$status, $price, $id]);
+            $this->syncStock($old, array_merge($old, ['status' => $status, 'unit_price' => $price]), $userId);
+        });
+    }
+
+    public function deleteLine(int $id, int $userId): void
+    {
+        Transaction::run(function () use ($id, $userId): void {
+            $old = $this->lock($id);
+            Database::pdo()->prepare('DELETE FROM ctl_sales WHERE id = ?')->execute([$id]);
+            $this->syncStock($old, null, $userId);
+        });
+    }
+
+    // ------------------------------------------------------------------ internos
+
+    /** Compara o antes e o depois da linha e ajusta o estoque só quando necessário. */
+    public function syncStock(?array $old, ?array $new, int $userId): void
+    {
+        $oldCounts = $old !== null && $old['status'] !== 'cancelado';
+        $newCounts = $new !== null && $new['status'] !== 'cancelado';
+        if ($oldCounts && $newCounts) {
+            $same = true;
+            foreach (['location_id', 'flavor_id', 'size_id', 'qty'] as $key) $same = $same && (int) $old[$key] === (int) $new[$key];
+            if ($same) return;
+        }
+        if ($oldCounts) {
+            $this->stock->restore((int) $old['location_id'], (int) $old['flavor_id'], (int) $old['size_id'], (int) $old['qty'], 'Estorno do pedido #' . $old['order_no'], (int) $old['id'], (int) $old['order_no'], $userId);
+        }
+        if ($newCounts) {
+            $this->stock->consume((int) $new['location_id'], (int) $new['flavor_id'], (int) $new['size_id'], (int) $new['qty'], 'Venda do pedido #' . $new['order_no'], (int) $new['id'], (int) $new['order_no'], $userId);
+        }
+    }
+
+    private function lock(int $id): array
+    {
+        $stmt = Database::pdo()->prepare('SELECT * FROM ctl_sales WHERE id = ? FOR UPDATE');
+        $stmt->execute([$id]);
+        return $stmt->fetch() ?: throw new DomainException('Lançamento não encontrado.');
+    }
+
+    /** @return array{flavor_id:int,size_id:int,qty:int,unit_price:float,status:string} */
+    public function normalizeLine(array $raw, int $locationId): array
+    {
+        $flavorId = (int) ($raw['flavor_id'] ?? 0);
+        $sizeId = (int) ($raw['size_id'] ?? 0);
+        $qty = filter_var($raw['qty'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 9999]]);
+        $status = (string) ($raw['status'] ?? 'a_fazer');
+        if (!isset(self::STATUSES[$status])) throw new DomainException('Situação inválida.');
+        if ($qty === false) throw new DomainException('Informe uma quantidade entre 1 e 9999.');
+
+        $pdo = Database::pdo();
+        $flavor = $pdo->prepare('SELECT name FROM ctl_flavors WHERE id = ?');
+        $flavor->execute([$flavorId]);
+        $flavorName = $flavor->fetchColumn();
+        $size = $pdo->prepare('SELECT name FROM ctl_sizes WHERE id = ?');
+        $size->execute([$sizeId]);
+        $sizeName = $size->fetchColumn();
+        if ($flavorName === false || $sizeName === false) throw new DomainException('Escolha o sabor e o tamanho.');
+
+        $typed = trim((string) ($raw['unit_price'] ?? ''));
+        $price = Money::parse($typed);
+        if ($typed !== '' && $price === null) throw new DomainException('Valor unitário inválido. Use algo como 17,00.');
+        if ($status === 'resgate') {
+            $price = 0.0;
+        } else {
+            $price ??= $this->catalog->price($flavorId, $sizeId, $locationId);
+            if ($price === null) throw new DomainException("Sem preço cadastrado para $flavorName $sizeName. Informe o valor unitário.");
+        }
+        return ['flavor_id' => $flavorId, 'size_id' => $sizeId, 'qty' => $qty, 'unit_price' => $price, 'status' => $status];
+    }
+
+    private function validLocation(int $id): int
+    {
+        $stmt = Database::pdo()->prepare('SELECT 1 FROM ctl_locations WHERE id = ?');
+        $stmt->execute([$id]);
+        if (!$stmt->fetchColumn()) throw new DomainException('Escolha o local da venda.');
+        return $id;
+    }
+
+    public function parseDate(string $value): string
+    {
+        $date = DateTimeImmutable::createFromFormat('!Y-m-d', trim($value));
+        if (!$date || $date->format('Y-m-d') !== trim($value)) throw new DomainException('Informe uma data válida.');
+        return $date->format('Y-m-d');
+    }
+
+    /** @return array{0:string[],1:array} condições SQL (alias s/c) e parâmetros para os filtros da tela */
+    private function conditions(array $filter): array
+    {
+        $where = [];
+        $params = [];
+        $month = (string) ($filter['month'] ?? 'all');
+        if (preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $month)) {
+            $where[] = 's.sale_date >= ? AND s.sale_date < ?';
+            $start = $month . '-01';
+            array_push($params, $start, date('Y-m-d', strtotime($start . ' +1 month')));
+        }
+        $status = (string) ($filter['status'] ?? '');
+        if (isset(self::STATUSES[$status])) {
+            $where[] = 's.status = ?';
+            $params[] = $status;
+        }
+        $search = trim((string) ($filter['q'] ?? ''));
+        if ($search !== '') {
+            $like = '%' . addcslashes($search, '%_\\') . '%';
+            $where[] = '(s.client_id IN (SELECT id FROM ctl_clients WHERE name LIKE ? OR phone LIKE ?))';
+            array_push($params, $like, $like);
+        }
+        return [$where, $params];
+    }
+}
