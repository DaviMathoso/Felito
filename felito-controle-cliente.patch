@@ -0,0 +1,23 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Core;
+
+/** Executa um bloco dentro de uma transação; se já houver uma aberta, apenas reaproveita. */
+final class Transaction
+{
+    public static function run(callable $work): mixed
+    {
+        $pdo = Database::pdo();
+        if ($pdo->inTransaction()) return $work();
+        $pdo->beginTransaction();
+        try {
+            $result = $work();
+            $pdo->commit();
+            return $result;
+        } catch (\Throwable $error) {
+            if ($pdo->inTransaction()) $pdo->rollBack();
+            throw $error;
+        }
+    }
+}
diff --git a/app/Services/CatalogoService.php b/app/Services/CatalogoService.php
new file mode 100644
index 0000000..a0e8c71
--- /dev/null
+++ b/app/Services/CatalogoService.php
@@ -0,0 +1,177 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+use App\Core\Money;
+use App\Core\Transaction;
+use DomainException;
+use PDOException;
+
+/** Locais de venda, sabores, tamanhos e tabela de preços do controle. */
+final class CatalogoService
+{
+    public const COLORS = ['#335b3d', '#b94e1c', '#125b80', '#8b3027', '#6b4c9a', '#8a6d1d', '#00838f', '#353027'];
+
+    public function flavors(bool $onlyActive = false): array
+    {
+        return Database::pdo()->query('SELECT id, name, is_active FROM ctl_flavors' . ($onlyActive ? ' WHERE is_active = 1' : '') . ' ORDER BY name')->fetchAll();
+    }
+
+    public function sizes(bool $onlyActive = false): array
+    {
+        return Database::pdo()->query('SELECT id, name, volume_ml, packaging_cost, is_active FROM ctl_sizes' . ($onlyActive ? ' WHERE is_active = 1' : '') . ' ORDER BY volume_ml, name')->fetchAll();
+    }
+
+    public function locations(bool $onlyActive = false): array
+    {
+        return Database::pdo()->query('SELECT id, name, color, is_default, is_active FROM ctl_locations' . ($onlyActive ? ' WHERE is_active = 1' : '') . ' ORDER BY is_default DESC, name')->fetchAll();
+    }
+
+    public function defaultLocationId(): int
+    {
+        $id = Database::pdo()->query('SELECT id FROM ctl_locations WHERE is_active = 1 ORDER BY is_default DESC, id LIMIT 1')->fetchColumn();
+        if ($id === false) throw new DomainException('Cadastre ao menos um local de venda ativo.');
+        return (int) $id;
+    }
+
+    public function saveFlavor(?int $id, string $name, bool $active): int
+    {
+        $name = trim($name);
+        if ($name === '' || mb_strlen($name) > 120) throw new DomainException('Informe o nome do sabor (até 120 caracteres).');
+        return $this->persist($id, 'ctl_flavors', ['name' => $name, 'is_active' => $active ? 1 : 0], 'Já existe um sabor com esse nome.');
+    }
+
+    public function saveSize(?int $id, string $name, int $volume, mixed $packaging, bool $active): int
+    {
+        $name = trim($name);
+        $cost = trim((string) $packaging) === '' ? 0.0 : Money::parse($packaging);
+        if ($name === '' || mb_strlen($name) > 60) throw new DomainException('Informe o nome do tamanho (até 60 caracteres).');
+        if ($volume < 1 || $volume > 100000) throw new DomainException('Informe o volume em mL (de 1 a 100000).');
+        if ($cost === null) throw new DomainException('Informe um custo de embalagem válido, por exemplo 0,80.');
+        return $this->persist($id, 'ctl_sizes', ['name' => $name, 'volume_ml' => $volume, 'packaging_cost' => $cost, 'is_active' => $active ? 1 : 0], 'Já existe um tamanho com esse nome.');
+    }
+
+    public function saveLocation(?int $id, string $name, string $color): int
+    {
+        $name = trim($name);
+        if ($name === '' || mb_strlen($name) > 80) throw new DomainException('Informe o nome do local (até 80 caracteres).');
+        if (!preg_match('/^#[0-9a-fA-F]{6}$/', $color)) $color = self::COLORS[0];
+        return $this->persist($id, 'ctl_locations', ['name' => $name, 'color' => $color], 'Já existe um local com esse nome.');
+    }
+
+    public function setDefaultLocation(int $id): void
+    {
+        Transaction::run(function () use ($id): void {
+            $pdo = Database::pdo();
+            $exists = $pdo->prepare('SELECT 1 FROM ctl_locations WHERE id = ?');
+            $exists->execute([$id]);
+            if (!$exists->fetchColumn()) throw new DomainException('Local não encontrado.');
+            $pdo->exec('UPDATE ctl_locations SET is_default = 0');
+            $pdo->prepare('UPDATE ctl_locations SET is_default = 1, is_active = 1 WHERE id = ?')->execute([$id]);
+        });
+    }
+
+    /** Ativa ou desativa um local (locais com histórico não são apagados). */
+    public function toggleLocation(int $id): bool
+    {
+        $pdo = Database::pdo();
+        $stmt = $pdo->prepare('SELECT is_active, is_default FROM ctl_locations WHERE id = ?');
+        $stmt->execute([$id]);
+        $location = $stmt->fetch();
+        if (!$location) throw new DomainException('Local não encontrado.');
+        if ((int) $location['is_active'] === 0) {
+            $pdo->prepare('UPDATE ctl_locations SET is_active = 1 WHERE id = ?')->execute([$id]);
+            return true;
+        }
+        if ((int) $location['is_default'] === 1) throw new DomainException('Defina outro local como padrão antes de desativar este.');
+        $others = $pdo->prepare('SELECT COUNT(*) FROM ctl_locations WHERE is_active = 1 AND id <> ?');
+        $others->execute([$id]);
+        if ((int) $others->fetchColumn() < 1) throw new DomainException('É preciso manter ao menos um local ativo.');
+        $pdo->prepare('UPDATE ctl_locations SET is_active = 0 WHERE id = ?')->execute([$id]);
+        return false;
+    }
+
+    public function toggleActive(string $table, int $id): void
+    {
+        if (!in_array($table, ['ctl_flavors', 'ctl_sizes'], true)) throw new DomainException('Cadastro inválido.');
+        Database::pdo()->prepare("UPDATE $table SET is_active = 1 - is_active WHERE id = ?")->execute([$id]);
+    }
+
+    /** Preços efetivos de um local: o preço próprio do local vale mais que o global. Chave "sabor|tamanho". */
+    public function priceMap(int $locationId): array
+    {
+        $stmt = Database::pdo()->prepare('SELECT flavor_id, size_id, location_id, price FROM ctl_prices WHERE location_id IN (0, ?)');
+        $stmt->execute([$locationId]);
+        $global = [];
+        $local = [];
+        foreach ($stmt->fetchAll() as $row) {
+            $key = $row['flavor_id'] . '|' . $row['size_id'];
+            if ((int) $row['location_id'] === 0) $global[$key] = (float) $row['price'];
+            else $local[$key] = (float) $row['price'];
+        }
+        return $local + $global;
+    }
+
+    /** Preços gravados somente para um local (0 = tabela global). */
+    public function ownPrices(int $locationId): array
+    {
+        $stmt = Database::pdo()->prepare('SELECT flavor_id, size_id, price FROM ctl_prices WHERE location_id = ?');
+        $stmt->execute([$locationId]);
+        $map = [];
+        foreach ($stmt->fetchAll() as $row) $map[$row['flavor_id'] . '|' . $row['size_id']] = (float) $row['price'];
+        return $map;
+    }
+
+    public function price(int $flavorId, int $sizeId, int $locationId): ?float
+    {
+        return $this->priceMap($locationId)[$flavorId . '|' . $sizeId] ?? null;
+    }
+
+    /** @param array<string,string> $prices chave "sabor|tamanho" => valor digitado (vazio remove o preço) */
+    public function savePrices(int $locationId, array $prices): int
+    {
+        $pdo = Database::pdo();
+        $flavors = array_column($this->flavors(), 'id');
+        $sizes = array_column($this->sizes(), 'id');
+        $saved = 0;
+        Transaction::run(function () use ($pdo, $locationId, $prices, $flavors, $sizes, &$saved): void {
+            $upsert = $pdo->prepare('INSERT INTO ctl_prices (flavor_id, size_id, location_id, price) VALUES (?, ?, ?, ?) ON DUPLICATE KEY UPDATE price = VALUES(price)');
+            $delete = $pdo->prepare('DELETE FROM ctl_prices WHERE flavor_id = ? AND size_id = ? AND location_id = ?');
+            foreach ($prices as $key => $raw) {
+                if (!preg_match('/^(\d+)\|(\d+)$/', (string) $key, $m)) continue;
+                [$flavorId, $sizeId] = [(int) $m[1], (int) $m[2]];
+                if (!in_array($flavorId, $flavors, true) || !in_array($sizeId, $sizes, true)) continue;
+                if (trim((string) $raw) === '') {
+                    $delete->execute([$flavorId, $sizeId, $locationId]);
+                    continue;
+                }
+                $price = Money::parse($raw);
+                if ($price === null || $price > 99999) throw new DomainException('Há um preço inválido na tabela. Use valores como 17,00.');
+                $upsert->execute([$flavorId, $sizeId, $locationId, $price]);
+                $saved++;
+            }
+        });
+        return $saved;
+    }
+
+    private function persist(?int $id, string $table, array $data, string $duplicateMessage): int
+    {
+        $pdo = Database::pdo();
+        try {
+            if ($id !== null) {
+                $set = implode(', ', array_map(static fn($column) => "$column = ?", array_keys($data)));
+                $pdo->prepare("UPDATE $table SET $set WHERE id = ?")->execute([...array_values($data), $id]);
+                return $id;
+            }
+            $columns = implode(', ', array_keys($data));
+            $marks = implode(', ', array_fill(0, count($data), '?'));
+            $pdo->prepare("INSERT INTO $table ($columns) VALUES ($marks)")->execute(array_values($data));
+            return (int) $pdo->lastInsertId();
+        } catch (PDOException $error) {
+            if ($error->getCode() === '23000') throw new DomainException($duplicateMessage);
+            throw $error;
+        }
+    }
+}
diff --git a/app/Services/ClienteService.php b/app/Services/ClienteService.php
new file mode 100644
index 0000000..9955fb4
--- /dev/null
+++ b/app/Services/ClienteService.php
@@ -0,0 +1,152 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+use App\Core\Transaction;
+use DomainException;
+use PDOException;
+
+/** Clientes do controle de vendas (não é a conta de acesso da loja online). */
+final class ClienteService
+{
+    public function list(string $search = ''): array
+    {
+        $sql = "SELECT c.id, c.name, c.phone,
+                       COUNT(DISTINCT s.order_no) AS orders_count,
+                       COALESCE(SUM(CASE WHEN s.status NOT IN ('cancelado', 'resgate') THEN s.qty * s.unit_price END), 0) AS total_spent,
+                       COALESCE(SUM(CASE WHEN s.status IN ('a_fazer', 'a_entregar', 'entregue') THEN s.qty * s.unit_price END), 0) AS open_amount
+                FROM ctl_clients c LEFT JOIN ctl_sales s ON s.client_id = c.id";
+        $params = [];
+        if (trim($search) !== '') {
+            $like = '%' . addcslashes(trim($search), '%_\\') . '%';
+            $sql .= ' WHERE c.name LIKE ? OR c.phone LIKE ?';
+            $params = [$like, $like];
+        }
+        $stmt = Database::pdo()->prepare($sql . ' GROUP BY c.id, c.name, c.phone ORDER BY c.name');
+        $stmt->execute($params);
+        return $stmt->fetchAll();
+    }
+
+    public function find(int $id): ?array
+    {
+        $stmt = Database::pdo()->prepare('SELECT id, name, phone FROM ctl_clients WHERE id = ?');
+        $stmt->execute([$id]);
+        return $stmt->fetch() ?: null;
+    }
+
+    /** Devolve o cliente com esse nome (cadastra se ainda não existir). */
+    public function findOrCreate(string $name, string $phone = ''): int
+    {
+        $name = $this->cleanName($name);
+        $phone = $this->cleanPhone($phone);
+        $pdo = Database::pdo();
+        $find = $pdo->prepare('SELECT id, phone FROM ctl_clients WHERE name = ?');
+        $find->execute([$name]);
+        $found = $find->fetch();
+        if (!$found) {
+            try {
+                $pdo->prepare('INSERT INTO ctl_clients (name, phone) VALUES (?, ?)')->execute([$name, $phone]);
+                return (int) $pdo->lastInsertId();
+            } catch (PDOException $error) {
+                if ($error->getCode() !== '23000') throw $error;
+                $find->execute([$name]);
+                $found = $find->fetch();
+                if (!$found) throw $error;
+            }
+        }
+        if ($phone !== '' && (string) $found['phone'] === '') {
+            $pdo->prepare('UPDATE ctl_clients SET phone = ? WHERE id = ?')->execute([$phone, $found['id']]);
+        }
+        return (int) $found['id'];
+    }
+
+    /** Cria ou edita. Se o novo nome já existir em outro cadastro, os dois são mesclados. Devolve o id final. */
+    public function save(?int $id, string $name, string $phone): int
+    {
+        $name = $this->cleanName($name);
+        $phone = $this->cleanPhone($phone);
+        $pdo = Database::pdo();
+        return (int) Transaction::run(function () use ($pdo, $id, $name, $phone): int {
+            $same = $pdo->prepare('SELECT id FROM ctl_clients WHERE name = ?');
+            $same->execute([$name]);
+            $otherId = $same->fetchColumn();
+            if ($id === null) {
+                if ($otherId !== false) throw new DomainException('Já existe um cliente com esse nome.');
+                $pdo->prepare('INSERT INTO ctl_clients (name, phone) VALUES (?, ?)')->execute([$name, $phone]);
+                return (int) $pdo->lastInsertId();
+            }
+            if ($otherId !== false && (int) $otherId !== $id) {
+                $other = (int) $otherId;
+                $pdo->prepare('UPDATE ctl_sales SET client_id = ? WHERE client_id = ?')->execute([$other, $id]);
+                $pdo->prepare('UPDATE ctl_gifts SET client_id = ? WHERE client_id = ?')->execute([$other, $id]);
+                $pdo->prepare("UPDATE ctl_clients SET phone = IF(phone = '', ?, phone) WHERE id = ?")->execute([$phone, $other]);
+                $pdo->prepare('DELETE FROM ctl_clients WHERE id = ?')->execute([$id]);
+                return $other;
+            }
+            $pdo->prepare('UPDATE ctl_clients SET name = ?, phone = ? WHERE id = ?')->execute([$name, $phone, $id]);
+            return $id;
+        });
+    }
+
+    public function delete(int $id): void
+    {
+        $pdo = Database::pdo();
+        $count = $pdo->prepare('SELECT COUNT(*) FROM ctl_sales WHERE client_id = ?');
+        $count->execute([$id]);
+        if ((int) $count->fetchColumn() > 0) {
+            throw new DomainException('Este cliente tem lançamentos e não pode ser removido. Para juntar cadastros repetidos, edite o nome para igualar ao outro.');
+        }
+        Transaction::run(function () use ($pdo, $id): void {
+            $pdo->prepare('DELETE FROM ctl_gifts WHERE client_id = ?')->execute([$id]);
+            $pdo->prepare('DELETE FROM ctl_clients WHERE id = ?')->execute([$id]);
+        });
+    }
+
+    /** Texto de cobrança para copiar e colar no WhatsApp. Devolve null se o cliente não tem valores em aberto. */
+    public function accountMessage(int $clientId): ?string
+    {
+        $stmt = Database::pdo()->prepare(
+            "SELECT f.name AS flavor, z.name AS size, SUM(s.qty) AS qty, SUM(s.qty * s.unit_price) AS total
+             FROM ctl_sales s JOIN ctl_flavors f ON f.id = s.flavor_id JOIN ctl_sizes z ON z.id = s.size_id
+             WHERE s.client_id = ? AND s.status IN ('a_fazer', 'a_entregar', 'entregue') AND s.qty * s.unit_price > 0
+             GROUP BY f.id, f.name, z.id, z.name, z.volume_ml ORDER BY f.name, z.volume_ml"
+        );
+        $stmt->execute([$clientId]);
+        $lines = $stmt->fetchAll();
+        if (!$lines) return null;
+        $message = '';
+        $total = 0.0;
+        foreach ($lines as $line) {
+            $message .= \money($line['total']) . ' por ' . (int) $line['qty'] . ' ' . $line['flavor'] . ' ' . $line['size'] . "\n";
+            $total += (float) $line['total'];
+        }
+        $message .= "\nTotal " . \money($total);
+        $pix = trim((string) \config('app.pix_key'));
+        if ($pix !== '') $message .= "\nPix: " . $pix;
+        return $message;
+    }
+
+    public static function whatsappLink(string $phone, string $text = ''): ?string
+    {
+        $digits = preg_replace('/\D+/', '', $phone) ?? '';
+        if (strlen($digits) < 10) return null;
+        if (!str_starts_with($digits, '55')) $digits = '55' . $digits;
+        return 'https://wa.me/' . $digits . ($text !== '' ? '?text=' . rawurlencode($text) : '');
+    }
+
+    private function cleanName(string $name): string
+    {
+        $name = trim(preg_replace('/\s+/', ' ', $name) ?? '');
+        if ($name === '' || mb_strlen($name) > 120) throw new DomainException('Informe o nome do cliente (até 120 caracteres).');
+        return $name;
+    }
+
+    private function cleanPhone(string $phone): string
+    {
+        $phone = trim($phone);
+        if (mb_strlen($phone) > 30) throw new DomainException('O telefone deve ter no máximo 30 caracteres.');
+        return $phone;
+    }
+}
diff --git a/app/Services/FidelidadeService.php b/app/Services/FidelidadeService.php
new file mode 100644
index 0000000..d23d42f
--- /dev/null
+++ b/app/Services/FidelidadeService.php
@@ -0,0 +1,187 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Core\Database;
+use App\Core\Money;
+use DomainException;
+use PDOException;
+
+/**
+ * Programa de selos: cada pedido gera floor(total do pedido ÷ valor por selo) selos dentro do período configurado.
+ * A cada "selos por brinde" acumulados nasce um voucher. Linhas em "Resgate" abatem selos; cancelados não pontuam.
+ */
+final class FidelidadeService
+{
+    public const PERIODS = ['days' => 'Últimos X dias', 'month' => 'Este mês', 'year' => 'Este ano', 'all' => 'Sem prazo (todo o histórico)'];
+    public const SORTS = ['name-asc' => 'Nome A→Z', 'name-desc' => 'Nome Z→A', 'stamps-desc' => 'Selos (maior)', 'stamps-asc' => 'Selos (menor)', 'gifts-pending' => 'Prêmios pendentes'];
+
+    private SettingsService $settings;
+
+    public function __construct()
+    {
+        $this->settings = new SettingsService();
+    }
+
+    public function config(): array
+    {
+        $type = $this->settings->get('fid_period_type', 'days');
+        return [
+            'stamp_value' => max(1.0, (float) $this->settings->get('fid_stamp_value', '15')),
+            'stamps_per_gift' => max(1, (int) $this->settings->get('fid_stamps_per_gift', '10')),
+            'period_type' => isset(self::PERIODS[$type]) ? $type : 'days',
+            'window_days' => max(1, (int) $this->settings->get('fid_window_days', '90')),
+        ];
+    }
+
+    public function saveConfig(array $in): void
+    {
+        $value = Money::parse($in['stamp_value'] ?? '');
+        $perGift = filter_var($in['stamps_per_gift'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 1000]]);
+        $days = filter_var($in['window_days'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 3650]]);
+        $type = (string) ($in['period_type'] ?? '');
+        if ($value === null || $value < 1) throw new DomainException('O valor por selo precisa ser de pelo menos R$ 1,00.');
+        if ($perGift === false) throw new DomainException('Informe quantos selos valem um brinde (de 1 a 1000).');
+        if (!isset(self::PERIODS[$type])) throw new DomainException('Escolha o período considerado.');
+        if ($type === 'days' && $days === false) throw new DomainException('Informe o número de dias da janela (de 1 a 3650).');
+        $this->settings->set('fid_stamp_value', (string) $value);
+        $this->settings->set('fid_stamps_per_gift', (string) $perGift);
+        $this->settings->set('fid_period_type', $type);
+        if ($days !== false) $this->settings->set('fid_window_days', (string) $days);
+    }
+
+    /** Data inicial da janela de pontuação (null = sem limite). */
+    public function cutoff(array $config): ?string
+    {
+        return match ($config['period_type']) {
+            'days' => date('Y-m-d', strtotime('-' . (int) $config['window_days'] . ' days')),
+            'month' => date('Y-m-01'),
+            'year' => date('Y-01-01'),
+            default => null,
+        };
+    }
+
+    /**
+     * Situação de cada cliente. Também cria os vouchers que já foram conquistados e ainda não existem.
+     * @return array<int,array<string,mixed>>
+     */
+    public function standings(string $search = '', string $sort = 'stamps-desc', ?int $onlyClient = null): array
+    {
+        $pdo = Database::pdo();
+        $config = $this->config();
+        $cutoff = $this->cutoff($config);
+
+        $clients = [];
+        $sql = 'SELECT id, name, phone FROM ctl_clients';
+        $params = [];
+        if ($onlyClient !== null) {
+            $sql .= ' WHERE id = ?';
+            $params[] = $onlyClient;
+        } elseif (trim($search) !== '') {
+            $sql .= ' WHERE name LIKE ? OR phone LIKE ?';
+            $like = '%' . addcslashes(trim($search), '%_\\') . '%';
+            array_push($params, $like, $like);
+        }
+        $stmt = $pdo->prepare($sql . ' ORDER BY name');
+        $stmt->execute($params);
+        foreach ($stmt->fetchAll() as $client) {
+            $clients[(int) $client['id']] = $client + ['earned' => 0, 'redeemed' => 0, 'gifts_total' => 0, 'gifts_pending' => 0];
+        }
+        if (!$clients) return [];
+
+        $orderSql = "SELECT client_id, order_no, SUM(qty * unit_price) AS total FROM ctl_sales WHERE status NOT IN ('resgate', 'cancelado')";
+        $orderParams = [];
+        if ($cutoff !== null) {
+            $orderSql .= ' AND sale_date >= ?';
+            $orderParams[] = $cutoff;
+        }
+        $orders = $pdo->prepare($orderSql . ' GROUP BY client_id, order_no');
+        $orders->execute($orderParams);
+        foreach ($orders->fetchAll() as $order) {
+            $id = (int) $order['client_id'];
+            if (isset($clients[$id])) $clients[$id]['earned'] += (int) floor((float) $order['total'] / $config['stamp_value']);
+        }
+        foreach ($pdo->query("SELECT client_id, COUNT(*) AS n FROM ctl_sales WHERE status = 'resgate' GROUP BY client_id")->fetchAll() as $row) {
+            if (isset($clients[(int) $row['client_id']])) $clients[(int) $row['client_id']]['redeemed'] = (int) $row['n'];
+        }
+        foreach ($pdo->query("SELECT client_id, COUNT(*) AS total, SUM(status = 'pendente') AS pending FROM ctl_gifts GROUP BY client_id")->fetchAll() as $row) {
+            if (isset($clients[(int) $row['client_id']])) {
+                $clients[(int) $row['client_id']]['gifts_total'] = (int) $row['total'];
+                $clients[(int) $row['client_id']]['gifts_pending'] = (int) $row['pending'];
+            }
+        }
+
+        foreach ($clients as $id => &$client) {
+            $due = intdiv((int) $client['earned'], $config['stamps_per_gift']);
+            if ($due > $client['gifts_total']) {
+                $created = $this->createVouchers($id, $due - $client['gifts_total']);
+                $client['gifts_total'] += $created;
+                $client['gifts_pending'] += $created;
+            }
+            $client['stamps'] = max(0, (int) $client['earned'] - (int) $client['redeemed'] * $config['stamps_per_gift']);
+        }
+        unset($client);
+
+        $list = array_values($clients);
+        usort($list, static fn($a, $b) => match ($sort) {
+            'name-desc' => strcasecmp((string) $b['name'], (string) $a['name']),
+            'stamps-asc' => $a['stamps'] <=> $b['stamps'] ?: strcasecmp((string) $a['name'], (string) $b['name']),
+            'gifts-pending' => $b['gifts_pending'] <=> $a['gifts_pending'] ?: strcasecmp((string) $a['name'], (string) $b['name']),
+            'name-asc' => strcasecmp((string) $a['name'], (string) $b['name']),
+            default => $b['stamps'] <=> $a['stamps'] ?: strcasecmp((string) $a['name'], (string) $b['name']),
+        });
+        return $list;
+    }
+
+    public function gifts(int $clientId): array
+    {
+        $stmt = Database::pdo()->prepare('SELECT id, voucher, status, created_at, redeemed_at FROM ctl_gifts WHERE client_id = ? ORDER BY id DESC');
+        $stmt->execute([$clientId]);
+        return $stmt->fetchAll();
+    }
+
+    public function redemptions(int $clientId): array
+    {
+        $stmt = Database::pdo()->prepare(
+            "SELECT s.order_no, s.sale_date, s.qty, f.name AS flavor_name, z.name AS size_name
+             FROM ctl_sales s JOIN ctl_flavors f ON f.id = s.flavor_id JOIN ctl_sizes z ON z.id = s.size_id
+             WHERE s.client_id = ? AND s.status = 'resgate' ORDER BY s.id DESC"
+        );
+        $stmt->execute([$clientId]);
+        return $stmt->fetchAll();
+    }
+
+    public function redeem(int $giftId): void
+    {
+        $stmt = Database::pdo()->prepare("UPDATE ctl_gifts SET status = 'resgatado', redeemed_at = UTC_TIMESTAMP() WHERE id = ? AND status = 'pendente'");
+        $stmt->execute([$giftId]);
+        if ($stmt->rowCount() === 0) throw new DomainException('Este brinde não está mais pendente.');
+    }
+
+    public function undoRedeem(int $giftId): void
+    {
+        $stmt = Database::pdo()->prepare("UPDATE ctl_gifts SET status = 'pendente', redeemed_at = NULL WHERE id = ? AND status = 'resgatado'");
+        $stmt->execute([$giftId]);
+        if ($stmt->rowCount() === 0) throw new DomainException('Este brinde não está resgatado.');
+    }
+
+    private function createVouchers(int $clientId, int $amount): int
+    {
+        $pdo = Database::pdo();
+        $insert = $pdo->prepare('INSERT INTO ctl_gifts (client_id, voucher) VALUES (?, ?)');
+        $created = 0;
+        for ($i = 0; $i < $amount; $i++) {
+            for ($attempt = 0; $attempt < 6; $attempt++) {
+                try {
+                    $insert->execute([$clientId, 'BRIND-' . strtoupper(bin2hex(random_bytes(3)))]);
+                    $created++;
+                    break;
+                } catch (PDOException $error) {
+                    if ($error->getCode() !== '23000') throw $error;
+                }
+            }
+        }
+        return $created;
+    }
+}
