APP_ENV=production
APP_HTTPS_ONLY=true
# Copie os valores exibidos em MySQL Databases no painel do InfinityFree.
DB_HOST=HOST_MYSQL_DO_PAINEL
DB_NAME=NOME_DO_BANCO_DO_PAINEL
DB_USER=USUARIO_DO_PAINEL
DB_PASS="SENHA_DO_BANCO_DO_PAINEL"

# Chave Pix mostrada na mensagem de cobrança do controle de vendas (opcional)
FELITO_PIX_KEY=
